{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grundschutzcheck/check-catalog-0.1.schema.json",
  "title": "GrundschutzCheck check catalog 0.1",
  "description": "Reusable catalog of read-only hardening checks. Consumers such as Quorum should read this document and keep mapping and windows11_carryover. Do not invent requirement ids. See docs/catalog-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog", "modules", "checks"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "released", "description", "target", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "released": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "applicability_note": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "url"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "version": { "type": "string" },
              "released": { "type": "string" },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 40,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "severity", "mapping", "windows11_carryover", "module",
        "references", "rationale", "conflict_note", "applicability_note",
        "evaluation", "remediation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "mapping": { "enum": ["verified", "unverified"] },
        "windows11_carryover": { "enum": ["verified", "unverified"] },
        "module": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string" }
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "conflict_note": { "type": "string" },
        "applicability_note": { "type": "string" },
        "evaluation": { "$ref": "#/$defs/evaluation" },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "gpo", "intune", "registry"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "gpo": { "type": "string", "minLength": 1 },
            "intune": { "type": "string", "minLength": 1 },
            "registry": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "requirement_id", "title", "mapping", "source_id", "note"],
      "properties": {
        "framework": { "enum": ["it-grundschutz-kompendium", "grundschutz-plus-plus"] },
        "requirement_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "mapping": { "enum": ["verified", "unverified"] },
        "source_id": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["registry", "secedit", "service", "defender", "feature", "secureboot", "bitlocker", "auditpol", "all_of", "any_of"]
        },
        "operator": {
          "enum": ["equals", "not_equals", "greater_or_equal", "less_or_equal", "in_range", "one_of", "bits_set"]
        },
        "expected": {},
        "when_absent": { "enum": ["fail", "pass", "not_applicable"] },
        "hive": { "type": "string" },
        "path": { "type": "string" },
        "name": { "type": "string" },
        "section": { "type": "string" },
        "key": { "type": "string" },
        "property": { "type": "string" },
        "subcategory": { "type": "string" },
        "subcategory_guid": {
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$"
        },
        "volume_type": { "type": "string" },
        "evaluations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evaluation" }
        }
      }
    }
  }
}
